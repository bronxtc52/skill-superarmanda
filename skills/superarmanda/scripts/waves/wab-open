#!/usr/bin/env bash
# Open the current wave of a chain inside a tmux popup (Ctrl+\ on the dashboard, see `wab.py watch`).
# Usage: wab-open <chain.json>   - the popup closes with Ctrl+\ (or detach with Ctrl-b d).
# The chain path travels as an argument, never inside code text.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
name=$(python3 -X utf8 "$here/wab.py" current-tmux "$1")
if [ -z "$name" ] || ! tmux has-session -t "$name" 2>/dev/null; then
  echo "Нет активной волны (цепочка завершена или окно закрыто). Enter — закрыть."; read -r; exit 0
fi
TMUX= exec tmux -u attach -f ignore-size -t "$name"
