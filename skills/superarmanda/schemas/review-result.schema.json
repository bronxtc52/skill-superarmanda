{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["status", "reviewed_head", "packet_hash", "findings", "missing_context"],
  "properties": {
    "status": {"type": "string", "enum": ["pass", "findings", "incomplete", "error"]},
    "reviewed_head": {"type": "string", "minLength": 1},
    "packet_hash": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object", "required": ["severity", "file", "line", "scenario", "evidence", "recommendation"], "properties": {"severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]}, "file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "scenario": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "missing_context": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
